# Model
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1
# Optional: MODEL_PROVIDER=anthropic with ANTHROPIC_API_KEY set uses the Anthropic API directly
# MODEL_PROVIDER=bedrock
# ANTHROPIC_API_KEY=

# Demo clock: all ages and deadlines are computed relative to this date
DEMO_TODAY=2026-09-12

# Storage
CHASER_DB_PATH=.data/chaser.db
# SESSION_BUCKET=my-bucket        # when set, sessions go to S3 instead of .data/sessions

# Web app
AGENT_BACKEND=local               # local | agentcore
# AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/ChaserAgent-xxxx
SWEEP_INTERVAL_SECONDS=7200       # every 2 hours; 0 disables the background scheduler
SWEEP_ON_START=0
