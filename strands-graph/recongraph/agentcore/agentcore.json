{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "recongraph",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "recongraph"
  },
  "runtimes": [
    {
      "name": "ReconGraphAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ReconGraphAgent/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "BEDROCK_MODEL_ID", "value": "global.anthropic.claude-sonnet-4-6" },
        { "name": "DEMO_TODAY", "value": "2026-09-12" },
        { "name": "CHASER_DB_PATH", "value": "/tmp/chaser.db" },
        { "name": "CHASER_SESSIONS_DIR", "value": "/tmp/sessions" }
      ],
      "instrumentation": {
        "enableOtel": true
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}